rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'sepehr.soleimani76@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidStorageRecord(data) {
      return data.keys().hasAll(['key', 'value', 'prefix', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'value', 'prefix', 'updatedAt']) &&
        data.key is string &&
        data.key.size() >= 1 &&
        data.key.size() <= 512 &&
        data.key.matches('^[a-zA-Z0-9_:\\-\\.äöüÄÖÜß\\s]+$') &&
        data.value is string &&
        data.value.size() >= 1 &&
        data.value.size() <= 900000 &&
        data.prefix is string &&
        data.prefix.size() >= 1 &&
        data.prefix.size() <= 64 &&
        data.prefix.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.prefix in ['user', 'session', 'recent'] &&
        data.updatedAt is string &&
        data.updatedAt.size() >= 10 &&
        data.updatedAt.size() <= 64;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'usernameLower', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'usernameLower', 'displayName', 'createdAt', 'updatedAt']) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.usernameLower is string &&
        data.usernameLower.size() >= 3 &&
        data.usernameLower.size() <= 20 &&
        data.usernameLower.matches('^[a-z0-9äöüß_\\-\\s]+$') &&
        data.displayName is string &&
        data.displayName.size() >= 3 &&
        data.displayName.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    match /app_storage/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if resource.data.prefix in ['user', 'session', 'recent'];
      allow create: if isValidId(recordId) && isValidStorageRecord(incoming());
      allow update: if isValidId(recordId) &&
        isValidStorageRecord(incoming()) &&
        incoming().key == existing().key &&
        incoming().prefix == existing().prefix &&
        incoming().diff(existing()).affectedKeys().hasOnly(['value', 'updatedAt']);
      allow delete: if isValidId(recordId) &&
        existing().prefix in ['user', 'session', 'recent'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().id == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['usernameLower', 'displayName', 'updatedAt']);
      allow delete: if isSignedIn() && isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() &&
        isVerifiedUser() &&
        isValidId(adminId) &&
        isAdmin() &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isVerifiedUser() && isValidId(adminId) && isAdmin();
    }
  }
}
